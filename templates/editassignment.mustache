{{!
    @template local_taskflow/editassignment
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    Example context (json):
    {
        "userid" : 1

    }
}}

<!-- Ensure the following markup resides within the content area of your Moodle page -->

<div class="container my-4">
    <a href="{{#returnurl}}{{returnurl}}{{/returnurl}}{{^returnurl}}#{{/returnurl}}"
        class="d-inline-flex align-items-center mb-3 text-decoration-none" data-region="editassignment-smartback">
        <i class="fa fa-arrow-left me-2" aria-hidden="true"></i>
        <span class="text-decoration-underline">{{#str}} back, core {{/str}}</span>
    </a>

  <!-- Assignment data -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">{{#str}} assignmentdata, local_taskflow {{/str}}</div>
    <div class="card-body">
      <dl class="row">
        {{#assignmentdata}}
        <dt class="col-md-3">{{label}}</dt>
        <dd class="col-md-9">{{{value}}}</dd>
        {{/assignmentdata}}
      </dl>
        <div data-id="assignmentform" data-assignmentid="{{id}}"
        {{#returnurl}}data-returnurl="{{returnurl}}"{{/returnurl}}>
        {{{editassignmentform}}}
        </div>
    </div>
  </div>
{{#hasinternalcommunication}}
  <!-- Chat -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
        {{#str}} internalcommunication, local_taskflow {{/str}}
    </div>
    <div class="card-body">
        <div data-id="internalcommunicationform" data-assignmentid="{{id}}">
            {{{internalcommunicationform}}}
        </div>
    </div>
  </div>
{{/hasinternalcommunication}}

{{#hascommentform}}
  <!-- Comments -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
        {{#str}} comment, local_taskflow {{/str}}
    </div>
    <div class="card-body">
        <div data-id="commentform" data-assignmentid="{{id}}"
             {{#returnurl}}data-returnurl="{{returnurl}}"{{/returnurl}}>
            {{{commentform}}}
        </div>
    </div>
  </div>
{{/hascommentform}}

{{#hashistory}}
  <!-- Historie -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">Historie</div>
    <div class="card-body p-0">
      {{{historylist}}}
    </div>
  </div>
{{/hashistory}}
</div>
{{#js}}
require(['local_taskflow/editassignmentform'], function(init) {
    init.init('[data-id="assignmentform"]', '{{{adapter}}}');
});
require(['local_taskflow/editassignmentback'], function(mod) {
    mod.init('[data-region="editassignment-smartback"]');
});
{{#hascommentform}}
require(['local_taskflow/commentform'], function(init) {
    init.init('[data-id="commentform"]', 'taskflowadapter_tuines\\form\\comment_form');
});
{{/hascommentform}}
{{#hasinternalcommunication}}
require(['local_taskflow/internalcommunicationform'], function(init) {
    init.init('[data-id="internalcommunicationform"]', 'taskflowadapter_tuines\\form\\internal_communication_form');
});
{{/hasinternalcommunication}}
{{/js}}