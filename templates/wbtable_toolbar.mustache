{{!
    @template local_taskflow/wbtable_toolbar

    Inner template of the compact wunderbyte_table layout (replaced on every ajax reload): the table rows,
    then one footer row with the record count, the pagination and the rows-per-page select.
    The bulk action buttons live in the toolbar of local_taskflow/wbtable_toolbar_container.

    Classes required for JS:
    * rows-container

    Data attributes required for JS:
    * data-columnname, data-sortable

    Example context (json):
    {
        "norecords": false,
        "uniqueid": "uniqueid",
        "idstring": "idstring",
        "encodedtable": "encodedtable",
        "table": {
            "header": {"headers": [{"key": "fullname", "localized": "Full name", "sortable": true}]},
            "rows": []
        }
    }
}}
{{#norecords}}
    <div class="norecordsfound">
        <div class="alert alert-warning" role="alert">{{#str}} norecords, local_wunderbyte_table {{/str}}</div>
    </div>
{{/norecords}}
{{^norecords}}
    {{#table}}
        <div class="wunderbyte-table-table">
            <div {{#stickyheader}} class="scroll-y" {{#tableheight}}style="height: {{tableheight}}px;" {{/tableheight}}{{/stickyheader}}>
                <table class="table" id="{{uniqueid}}">
                    <thead>
                        <tr>
                            {{#header}}
                                {{#headers}}
                                    <th class="{{key}} wb-table-column {{sortclass}}"
                                        data-columnname="{{key}}"
                                        {{#sortable}}data-sortable="{{sortable}}"{{/sortable}}>
                                        {{{localized}}}
                                    </th>
                                {{/headers}}
                            {{/header}}
                        </tr>
                    </thead>
                    <tbody class="rows-container">
                        {{#rows}}
                            {{> local_wunderbyte_table/twtable_list_row }}
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="local-taskflow-wbtable-footer">
            {{> local_wunderbyte_table/component_countlabel }}
            <div class="local-taskflow-wbtable-footer-end">
                {{> local_wunderbyte_table/component_pagination }}
                {{> local_wunderbyte_table/component_selectrows }}
            </div>
        </div>
    {{/table}}
    {{^table}}
        {{> local_wunderbyte_table/component_countlabel }}
    {{/table}}
    {{#js}}
        require(['local_wunderbyte_table/init'], function(init) {
            init.init('{{idstring}}', '{{encodedtable}}');
        });
    {{/js}}
{{/norecords}}
{{#errormessage}}
    <div class="alert alert-danger" role="alert">
        {{errormessage}}
    </div>
{{/errormessage}}
