{{!
    @template local_taskflow/wbtable_toolbar_container

    Outer template of the compact wunderbyte_table layout used on the Taskflow dashboard and person pages:
    one toolbar row (filter toggle, reload, bulk action buttons, sort, search) above the table.
    Same building blocks and component partials as local_wunderbyte_table/twtable_list_container,
    only arranged in one row. The inner part is local_taskflow/wbtable_toolbar, which is what ajax reloads replace.

    Classes required for JS:
    * wunderbyte_table_container_<idstring>

    Data attributes required for JS:
    * data-encodedtable

    Example context (json):
    {
       "uniqueid": "uniqueid",
       "idstring": "idstring",
       "encodedtable": "encodedtable",
       "showcomponentstoggle": true,
       "showfilterbutton": true,
       "filterdeactivated": true,
       "nofilteratall": false,
       "scrolltocontainer": true,
       "showfilterontop": false,
       "showdownloadbuttonatbottom": true,
       "actionbuttonslabel": "Apply to selected:",
       "showactionbuttons": [],
       "norecords": false,
       "table": {"header": {"headers": [{"key": "fullname", "localized": "Full name", "sortable": true}]}, "rows": []}
    }
}}
{{#norecords}}
    <div class="norecordsfound">
        <div class="alert alert-warning" role="alert">{{#str}} norecords, local_wunderbyte_table {{/str}}</div>
    </div>
{{/norecords}}
{{^norecords}}
    <div class="wunderbyte_table_container_{{idstring}} {{uniqueid}} local-taskflow-wbtable{{!
        }}{{#showfilterbutton}} wunderbyte_table_filter_on{{/showfilterbutton}}{{!
        }}{{#filterdeactivated}} inactivefilter{{/filterdeactivated}}{{!
        }}{{#nofilteratall}} nofilter{{/nofilteratall}}{{#scrolltocontainer}} wunderbyte_table_scroll_on{{/scrolltocontainer}}" data-encodedtable="{{encodedtable}}">
        <div class="local-taskflow-wbtable-toolbar">
            {{> local_wunderbyte_table/component_toggle }}
            {{> local_wunderbyte_table/component_reload }}
            {{> local_wunderbyte_table/component_edit }}
            {{> local_wunderbyte_table/component_actionbutton }}
            <div class="local-taskflow-wbtable-toolbar-end">
                {{> local_wunderbyte_table/component_spinner }}
                {{> local_wunderbyte_table/component_switchtemplates }}
                {{> local_wunderbyte_table/component_sort }}
                {{> local_wunderbyte_table/component_search }}
            </div>
        </div>
        {{^showdownloadbuttonatbottom}}
            <div>{{> local_wunderbyte_table/component_print }}</div>
        {{/showdownloadbuttonatbottom}}
        <div class="wunderbyte_table_container {{uniqueid}} {{#showfilterontop}}showontop{{/showfilterontop}}">
            <aside tabindex="-1" id="filteroptions_{{idstring}}" aria-label="{{#str}} filter_heading, local_wunderbyte_table {{/str}}" class="wunderbyte_table_components{{^showcomponentstoggle}} inactive{{/showcomponentstoggle}}">
                {{> local_wunderbyte_table/component_filter }}
                {{> local_wunderbyte_table/component_infinitescroll }}
            </aside>
            <div class="wunderbyteTableClass table-responsive {{uniqueid}}" id="a{{idstring}}">
                {{> local_taskflow/wbtable_toolbar }}
            </div>
        </div>
        {{#showdownloadbuttonatbottom}}
            <div class="local-taskflow-wbtable-download">{{> local_wunderbyte_table/component_print }}</div>
        {{/showdownloadbuttonatbottom}}
    </div>
    {{#js}}
        require(['local_wunderbyte_table/init'], function(init) {
            init.init('{{idstring}}', '{{encodedtable}}');
        });
    {{/js}}
{{/norecords}}
