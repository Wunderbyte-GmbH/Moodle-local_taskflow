{{!
    @template local_taskflow/wizard/preview_import_report

    Wunderbyte-agent side-pane preview: adapter import diagnosis.
    All values are pre-escaped and localized by taskflow_import_report_preview_renderer.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * title, errorcount, errorclass - string
    * lastrunlabel, lastrun - string
    * counters - array: {label, value}
    * errors - array: {time, event, message}
    * unmapped - array: {label, function}
    * warnings, recommendations - array: {text}
    * adapterskilllabel, adapterskill - string
    * links - array: {url, label}

    Example context (json):
    {
        "title": "Import diagnosis · adapter tuines",
        "errorcount": "Errors: 2",
        "errorclass": "badge bg-danger",
        "lastrunlabel": "Last run",
        "lastrun": "fetch_dwh_data · 3 September 2026, 2:00 AM",
        "counterslabel": "Counters",
        "hascounters": true,
        "counters": [{"label": "Users", "value": "1204"}],
        "errorslabel": "Errors",
        "haserrors": true,
        "errors": [{"time": "2 September 2026", "event": "dwh_fetch_failed", "message": "timeout"}],
        "unmappedlabel": "Unmapped translator functions",
        "hasunmapped": true,
        "unmapped": [{"label": "Long Leave", "function": "translator_user_longleave"}],
        "haswarnings": true,
        "warnings": [{"text": "7 unit member(s) have no supervisor."}],
        "recommendationslabel": "Recommendations",
        "hasrecommendations": true,
        "recommendations": [{"text": "Map the translator function(s) Long Leave."}],
        "adapterskilllabel": "Adapter skill",
        "hasadapterskill": true,
        "adapterskill": "taskflowadapter_tuines.diagnose_dwh_import",
        "links": [{"url": "https://example.org/local/taskflow/documentation.php?file=user/adapters/README.md", "label": "Open documentation"}]
    }
}}
<div class="taskflow-import-report">
    <h6 class="mb-2">{{{title}}} <span class="{{{errorclass}}}">{{{errorcount}}}</span></h6>
    <table class="table table-sm mb-2">
        <tbody>
            <tr>
                <th scope="row" class="fw-normal text-muted pe-3">{{{lastrunlabel}}}</th>
                <td>{{{lastrun}}}</td>
            </tr>
            {{#hascounters}}
            <tr>
                <th scope="row" class="fw-normal text-muted pe-3">{{{counterslabel}}}</th>
                <td>{{#counters}}<span class="badge bg-light text-dark">{{{label}}}: {{{value}}}</span> {{/counters}}</td>
            </tr>
            {{/hascounters}}
            {{#hasadapterskill}}
            <tr>
                <th scope="row" class="fw-normal text-muted pe-3">{{{adapterskilllabel}}}</th>
                <td><code>{{{adapterskill}}}</code></td>
            </tr>
            {{/hasadapterskill}}
        </tbody>
    </table>
    {{#haserrors}}
    <details class="mb-2">
        <summary>{{{errorslabel}}}</summary>
        <ul class="list-unstyled mb-0 ms-3">
            {{#errors}}<li class="small"><span class="text-muted">{{{time}}}</span> {{{event}}} {{{message}}}</li>{{/errors}}
        </ul>
    </details>
    {{/haserrors}}
    {{#hasunmapped}}
    <details class="mb-2">
        <summary>{{{unmappedlabel}}}</summary>
        <ul class="list-unstyled mb-0 ms-3">
            {{#unmapped}}<li class="small">{{{label}}} <code>{{{function}}}</code></li>{{/unmapped}}
        </ul>
    </details>
    {{/hasunmapped}}
    {{#haswarnings}}
    <ul class="list-unstyled mb-2">
        {{#warnings}}<li class="small"><span class="text-warning fw-bold me-1" aria-hidden="true">⚠</span>{{{text}}}</li>{{/warnings}}
    </ul>
    {{/haswarnings}}
    {{#hasrecommendations}}
    <p class="mb-1 text-muted">{{{recommendationslabel}}}</p>
    <ul class="mb-2 ps-3">
        {{#recommendations}}<li class="small">{{{text}}}</li>{{/recommendations}}
    </ul>
    {{/hasrecommendations}}
    {{#links}}
    <span class="small me-2"><a href="{{url}}" target="_blank" rel="noopener">{{{label}}}</a></span>
    {{/links}}
</div>
