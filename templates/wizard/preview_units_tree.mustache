{{!
    @template local_taskflow/wizard/preview_units_tree

    Wunderbyte-agent side-pane preview: organisational units as a nested <details> tree.
    All values are pre-escaped/localized by taskflow_units_tree_preview_renderer; 'tree'
    is the pre-built nested markup (mustache cannot recurse without a partial).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * title - string: card title (already contains the count)
    * backend - string: unit or cohort
    * tree - string: pre-rendered nested list markup
    * hasrows - bool
    * emptytext - string

    Example context (json):
    {
        "title": "3 unit(s)",
        "hasbackend": true,
        "backendprefix": "Backend",
        "backend": "unit",
        "hasfilters": false,
        "filtersprefix": "Filters",
        "filters": "",
        "hasrows": true,
        "tree": "<ul class=\"list-unstyled mb-0\"><li><details open><summary>Administration</summary></details></li></ul>",
        "emptytext": "No units found."
    }
}}
<h6 class="mb-2">{{{title}}}{{#hasbackend}} <span class="badge bg-light text-dark fw-normal">{{{backendprefix}}}: {{{backend}}}</span>{{/hasbackend}}</h6>
{{#hasfilters}}
<p class="text-muted small mb-2">{{{filtersprefix}}}: {{{filters}}}</p>
{{/hasfilters}}
{{#hasrows}}
<div class="taskflow-ai-preview-units-tree">{{{tree}}}</div>
{{/hasrows}}
{{^hasrows}}
<p class="text-muted mb-0">{{{emptytext}}}</p>
{{/hasrows}}
