{{!
    @template local_taskflow/wizard/preview_assignment_list

    Wunderbyte-agent side-pane preview: compact table of taskflow assignments.
    All values are pre-escaped/localized by taskflow_assignment_list_preview_renderer.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * title - string: card title (already contains the count)
    * scopelabel - string: scope name (admin/supervisor/self), may be empty
    * rows - array: one entry per assignment (id, url, fullname, rulename, ruleurl, due, badge, counters)
    * hasrows - bool
    * emptytext - string
    * headers - object: column headers
    * dashboard - object: {url, label}

    Example context (json):
    {
        "title": "2 assignments",
        "scopelabel": "Supervisor",
        "scopeprefix": "Scope",
        "hasfilters": true,
        "filtersprefix": "Filters",
        "filters": "overdue only",
        "hasrows": true,
        "haschange": false,
        "rows": [
            {
                "id": 4711,
                "url": "https://example.org/local/taskflow/assignment.php?id=4711",
                "fullname": "Anna Muster",
                "userurl": "https://example.org/user/profile.php?id=5",
                "rulename": "Data protection basics",
                "ruleid": 17,
                "ruleurl": "https://example.org/local/taskflow/editrule.php?id=17",
                "due": {"text": "12 August 2026", "relative": "−23 days", "class": "badge bg-danger", "title": "12 August 2026, 00:00"},
                "badge": {"label": "Overdue", "class": "badge bg-danger", "glyph": "●", "srtext": "Active"},
                "counters": "1× / 2×",
                "inactive": false,
                "inactivetext": "Inactive",
                "change": ""
            }
        ],
        "emptytext": "No assignments match the request.",
        "showing": "Showing 1 of 2",
        "headers": {"id": "#", "fullname": "Name", "rule": "Rule", "duedate": "Due date", "status": "Status", "change": "Change"},
        "dashboard": {"url": "https://example.org/local/taskflow/index.php", "label": "Open dashboard"}
    }
}}
<h6 class="mb-2">{{{title}}}{{#scopelabel}} <span class="badge bg-light text-dark fw-normal">{{{scopeprefix}}}: {{{scopelabel}}}</span>{{/scopelabel}}</h6>
{{#hasfilters}}
<p class="text-muted small mb-2">{{{filtersprefix}}}: {{{filters}}}</p>
{{/hasfilters}}
{{#hasrows}}
<div class="table-responsive">
    <table class="table table-sm mb-2 taskflow-ai-preview-assignment-list">
        <thead>
            <tr>
                <th scope="col">{{{headers.id}}}</th>
                <th scope="col">{{{headers.fullname}}}</th>
                <th scope="col">{{{headers.rule}}}</th>
                <th scope="col">{{{headers.duedate}}}</th>
                <th scope="col">{{{headers.status}}}</th>
                {{#haschange}}<th scope="col">{{{headers.change}}}</th>{{/haschange}}
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <th scope="row"><a href="{{url}}" target="_blank" rel="noopener">{{{id}}}</a></th>
                <td>{{#userurl}}<a href="{{userurl}}" target="_blank" rel="noopener">{{{fullname}}}</a>{{/userurl}}{{^userurl}}{{{fullname}}}{{/userurl}}</td>
                <td>{{#ruleurl}}<a href="{{ruleurl}}" target="_blank" rel="noopener">{{{rulename}}}</a>{{/ruleurl}}{{^ruleurl}}{{{rulename}}}{{/ruleurl}}</td>
                <td>{{#due}}<span title="{{{title}}}">{{{text}}}</span> <span class="{{{class}}}">{{{relative}}}</span>{{/due}}{{^due}}–{{/due}}</td>
                <td>
                    <span class="{{{badge.class}}}"><span aria-hidden="true">{{{badge.glyph}}}</span> {{{badge.label}}}<span class="visually-hidden"> ({{{badge.srtext}}})</span></span>
                    {{#counters}}<small class="text-muted">{{{counters}}}</small>{{/counters}}
                    {{#inactive}}<span class="badge bg-secondary">{{{inactivetext}}}</span>{{/inactive}}
                </td>
                {{#haschange}}<td>{{{change}}}</td>{{/haschange}}
            </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
{{#showing}}<p class="text-muted small mb-2">{{{showing}}}</p>{{/showing}}
{{/hasrows}}
{{^hasrows}}
<p class="text-muted mb-2">{{{emptytext}}}</p>
{{/hasrows}}
<p class="mb-0 small"><a href="{{dashboard.url}}" target="_blank" rel="noopener">{{{dashboard.label}}}</a></p>
