{{!
    @template local_taskflow/bulk_parked_list_row

    One message that still has parked sends. The visible row summarises the burst, and the
    row below it holds the list of affected users together with the two buttons that act on
    the whole message. The buttons live inside the panel so that clicking one never also
    toggles the panel it sits in.

    Context variables required for this template:
    * rowid - string: unique id of the row, used to tie the toggle to its panel
    * rowclasses - string: css classes of the row
    * datafields - array: data attributes of the row
    * cardbody - array: the visible summary columns
    * invisiblerow - object: the collapsible panel

    Example context (json):
    {
        "rowid": "row7",
        "rowclasses": "",
        "cardbody": [
            {
                "columnclass": "messagename",
                "key": "messagename",
                "localized": "Message",
                "value": "Reminder before due date"
            }
        ],
        "invisiblerow": {
            "columnclass": "text-muted",
            "key": "users",
            "value": "<ul><li>Anna Berger</li></ul>",
            "localized": "Parked users",
            "rowid": "row7"
        }
    }
}}

<tr id="{{rowid}}" class="{{rowclasses}}" {{#datafields}} data-{{key}}="{{value}}" {{/datafields}}>
  {{#cardbody}}
    <td class="{{columnclass}} {{key}} {{^value}}novalue{{/value}}"
        data-label="{{key}}"
        data-localized="{{localized}}"
        data-toggle="collapse"
        data-bs-toggle="collapse"
        data-target="#collapseRow{{rowid}}"
        data-bs-target="#collapseRow{{rowid}}"
        role="button"
        aria-controls="collapseRow{{rowid}}">
      {{#columniclassbefore}}
        <i class="{{.}}" aria-hidden="true"></i>
      {{/columniclassbefore}}
      {{{value}}}
    </td>
  {{/cardbody}}
</tr>

{{#invisiblerow}}
<tr>
  <td colspan="4" class="{{columnclass}} {{key}} {{^value}}novalue{{/value}} border-0"
      data-label="{{key}}"
      data-localized="{{localized}}">
    <div class="collapse my-2 mx-4 bl-border-left" id="collapseRow{{rowid}}">
      {{{value}}}
    </div>
  </td>
</tr>
{{/invisiblerow}}
