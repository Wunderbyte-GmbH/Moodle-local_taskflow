{{!
    @template local_taskflow/personpage

    The person page: profile facts, KPIs, assignments, individually assigned curricula, completions and competencies.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action="assignrule"
    * data-action="addpersonnote"

    Example context (json):
    {
        "userid": 5,
        "canassign": true,
        "user": {"id": 5, "fullname": "Anna Steiner", "email": "anna@example.com", "picture": "<img src=\"#\" alt=\"\">", "profileurl": "#"},
        "facts": [{"icon": "fa-sitemap", "label": "Units", "value": "Sales"}],
        "kpis": [{"value": 3, "label": "Completed", "icon": "fa-check-circle", "class": "text-success"}],
        "haspersonalrules": true,
        "personalrules": [{"ruleid": 1, "rulename": "Leadership curriculum", "statusname": "Assigned", "statusclass": "badge bg-primary", "assignedby": "assigned on 1 Sep 2026 by HR", "unassignurl": "#"}],
        "assignmentstable": "<table></table>",
        "hascompletions": true,
        "completions": [{"date": "1 Sep 2026", "type": "Certificate", "icon": "fa-certificate", "name": "Data protection", "url": "#"}],
        "hascompetencies": true,
        "competencies": [{"name": "First aid", "proficient": true, "date": "1 Sep 2026", "url": "#"}],
        "canviewnotes": true,
        "cancreatenotes": true,
        "hasnotes": true,
        "notes": [{"id": 1, "text": "Talk about the curriculum.", "author": "Petra Hofer", "date": "10 September 2026, 14:00", "candelete": true, "deleteurl": "#"}],
        "dashboardurl": "#",
        "organisationurl": "#",
        "isperson": true,
        "switcher": "<form></form>"
    }
}}
<div class="local-taskflow-personpage" data-userid="{{userid}}">
    {{> local_taskflow/pagenav }}
    {{> local_taskflow/personpage_content }}
</div>
