{{!
    @template local_adele/initview
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    {{!
    Example context (json):
    {
        "userid": 1,
        "profile": {
            "entries": 0,
            "certificates": 0,
            "allentries": 0,
            "hascourses": true,
            "courses": [
                {"name": "Datenschutz-Grundschulung", "url": "#", "completed": false, "status": "Not completed"}
            ],
            "chart": "<div>Chart</div>"
        }
    }
}}

<div class="row mb-4">
    <!-- Box: Weiterbildungsprofil -->
    <div class="col-md-6 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="me-3 display-4 text-primary">
                    <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">{{#str}} traininghistory, local_taskflow {{/str}}</h6>
                    <p class="mb-1">
                        {{#userid}}
                            <a href='/mod/booking/mybookings.php?userid={{userid}}&completed=1&filter=1&typefilter=1'>
                        {{/userid}}
                        {{^userid}}
                            <a href='/mod/booking/mybookings.php&completed=1&filter=1&typefilter=1'>
                        {{/userid}}
                            <strong>{{profile.entries}}</strong> {{#str}} coursesfinished, local_taskflow {{/str}}
                        </a>
                    </p>
                    <p class="mb-0">
                        {{#userid}}
                            <a href='/local/taskflow/mycertificates.php?userid={{userid}}'>
                        {{/userid}}
                        {{^userid}}
                            <a href='/local/taskflow/mycertificates.php'>
                        {{/userid}}
                            <strong>{{profile.certificates}}</strong> {{#str}} certificates, local_taskflow {{/str}}
                        </a>
                    </p>
                    <p class="mb-1">
                        {{#userid}}
                            <a href='/mod/booking/mybookings.php?userid={{userid}}&filter=1&typefilter=1'>
                        {{/userid}}
                        {{^userid}}
                            <a href='/mod/booking/mybookings.php&filter=1&typefilter=1'>
                        {{/userid}}
                            <strong>{{profile.allentries}}</strong> {{#str}} coursesenrolled, local_taskflow {{/str}}
                        </a>
                    </p>
                    {{#profile.hascourses}}
                        <h6 class="text-muted mt-3 mb-1">{{#str}} assignedcourses, local_taskflow {{/str}}</h6>
                        <ul class="list-unstyled mb-0">
                            {{#profile.courses}}
                                <li class="mb-1">
                                    <i class="fa {{#completed}}fa-check-circle text-success{{/completed}}{{^completed}}fa-regular fa-circle text-muted{{/completed}} me-1" aria-hidden="true"></i>
                                    <a href="{{url}}">{{name}}</a>
                                    <span class="text-muted small">({{status}})</span>
                                </li>
                            {{/profile.courses}}
                        </ul>
                    {{/profile.hascourses}}
                </div>
            </div>
        </div>
    </div>

    <!-- Box: Lernaktivität mit Kreisdiagramm -->
    <div class="col-md-6 mb-3">
        <div class="card h-100 shadow-sm rounded-2xl">
            <div class="card-body">
                <h5 class="card-title mb-3">{{#str}} courses, local_taskflow {{/str}}</h5>
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <!-- Kreisdiagramm: kommt per JS oder extern rein -->
                        <canvas id="lernaktivitaet-chart-{{uniqid}}" width="100" height="100"></canvas>
                    </div>
                    {{{profile.chart}}}
                </div>
            </div>
        </div>
    </div>
</div>