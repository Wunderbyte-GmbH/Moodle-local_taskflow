{{!
    @template local_taskflow/supervisordashboard

    Supervisor dashboard showing pending approvals, requests, charts, and team overview.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * approvals - HTML of pending approvals
    * requests - HTML of pending applications
    * chart - HTML/JS chart of overview
    * supervisorteam - HTML table/list of team members
    * supervisorassignments - HTML detail view content

    Example context (json):
    {
        "approvals": [
            "<p>Approval item 1</p>",
            "<p>Approval item 2</p>"
        ],
        "requests": [
            "<p>Request item1</p>",
            "<p>Request item2</p>"
        ],
        "chart": "<div id='chart'></div>",
        "supervisorteam": "<ul><li>Team member</li></ul>",
        "supervisorassignments": "<div>Assignments here</div>"
    }
}}

<div class="supervisor-dashboard container-fluid my-4">
    <!-- Row for approvals and requests -->
    <div class="row">
        <div class="col-md-6 mb-4 d-flex">
            <div class="card shadow-sm rounded-2xl flex-fill">
                <div class="card-header bg-primary text-white">
                    {{#str}}pendingapprovals, local_taskflow{{/str}}
                </div>
                <div class="card-body">
                    {{#approvals}}
                        {{{.}}}
                    {{/approvals}}
                    {{^approvals}}
                        <p class="text-muted">{{#str}}noapprovals, local_taskflow{{/str}}</p>
                    {{/approvals}}
                </div>
            </div>
        </div>
        <!-- Applications -->
        <div class="col-md-6 mb-4 d-flex">
            <div class="card shadow-sm rounded-2xl flex-fill">
                <div class="card-header bg-primary text-white">
                    {{#str}}pendingapplications, local_taskflow{{/str}}
                </div>
                <div class="card-body">
                    {{#requests}}
                        {{{.}}}
                    {{/requests}}
                    {{^requests}}
                        <p class="text-muted">{{#str}}noapplications, local_taskflow{{/str}}</p>
                    {{/requests}}
                </div>
            </div>
        </div>
    </div>

    <!-- Overdue Assignments and Booking Team -->
    <div class="row">
        <div class="col-6 mb-4 d-flex">
            <div class="card shadow-sm rounded-2xl flex-fill">
                <div class="card-header bg-primary text-white">
                   {{#str}}overview, local_taskflow{{/str}}
                </div>
                <div class="card-body">
                    {{{chart}}}
                </div>
            </div>
        </div>
        <div class="col-6 mb-4 d-flex">
            <div class="card shadow-sm rounded-2xl flex-fill">
                <div class="card-header bg-primary text-white">
                    {{#str}}supervisorteam, local_taskflow{{/str}}
                </div>
                <div class="card-body">
                    {{{supervisorteam}}}
                </div>
            </div>
        </div>
    </div>
    <div class="row">
            <div class="col-md-12 mb-6 d-flex">
                <div class="card shadow-sm rounded-2xl flex-fill">
                    <div class="card-header bg-primary text-white">
                       {{#str}}detailviewdashboard, local_taskflow{{/str}}
                    </div>
                    <div class="card-body">
                        {{{supervisorassignments}}}
                    </div>
                </div>
            </div>
        </div>
</div>
