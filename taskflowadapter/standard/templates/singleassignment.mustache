{{!
    @template taskflowadapter_standard/singleassignment

    Assignment detail page of the Standard adapter: local_taskflow/singleassignment with the status shown
    as a prominent badge at the top of the card. Everything else comes from the core template.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Example context (json):
    {
        "userid": 12345,
        "fullname": "Alice Johnson",
        "profilepicurl": "https://moodle.example.com/user/pix.php/123/f1.jpg",
        "assignmentstatus": {"name": "Overdue (1)", "statusclass": "local-taskflow-status-10"},
        "assignmentdata": {
            "description": "Please complete the assigned trainings before the deadline.",
            "duedate": "10 June 2025",
            "target": []
        }
    }
}}
{{< local_taskflow/singleassignment }}
    {{$assignmentstatus}}
        {{#assignmentstatus}}
            <div class="local-taskflow-assignmentstatus d-flex align-items-center flex-wrap mb-3">
                <span class="text-muted me-2">{{#str}} status, core {{/str}}:</span>
                <span class="local-taskflow-status {{statusclass}}">{{name}}</span>
            </div>
        {{/assignmentstatus}}
    {{/assignmentstatus}}
{{/ local_taskflow/singleassignment }}
